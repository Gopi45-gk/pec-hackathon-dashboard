# ==============================================================================
# PEC HACKATHON PARTICIPATION & WINNERS DASHBOARD 2026 - ENVIRONMENT CONFIG
# ==============================================================================

# Google Spreadsheet ID (found in Google Sheets URL between /d/ and /edit)
# Example: https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit
# Leave blank to use authentic PEC 2026 baseline records, or paste your real ID:
VITE_GOOGLE_SHEETS_ID=

# Sheet Tab Names in the Workbook
VITE_PARTICIPATION_SHEET_NAME=Participation
VITE_WINNERS_SHEET_NAME=Winners

# Sync Mode: 'gviz' (Google Visualization API - recommended for public view links)
#             'csv'  (Published CSV export)
#             'gas'  (Google Apps Script web app for private sheets)
VITE_CONNECTION_MODE=gviz

# Auto Refresh Interval in Seconds (default: 30)
VITE_AUTO_REFRESH_INTERVAL=30

# Optional: Google Apps Script Web App URL (only needed if VITE_CONNECTION_MODE=gas)
VITE_GAS_WEBAPP_URL=
